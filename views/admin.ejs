<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestão de Usuários - Portal SEAP</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #0a7d2a;
      --dark-color: #044c14;
      --bg-color: #ecf0f3;
      --text-dark: #2c3e50;
    }

    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      background-color: var(--bg-color);
      color: var(--text-dark);
    }

    header {
      background: linear-gradient(120deg, var(--dark-color), var(--primary-color));
      color: white;
      padding: 25px 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .header-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    header h1 {
      font-family: 'Poppins', sans-serif;
      margin: 0;
      font-size: 1.5rem;
      text-transform: uppercase;
    }

    .btn-voltar {
      background: rgba(255,255,255,0.2);
      color: white;
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: background 0.2s;
    }

    .btn-voltar:hover { background: rgba(255,255,255,0.3); }

    .container {
      max-width: 1100px;
      margin: 35px auto;
      padding: 0 20px;
    }

    .table-card {
      background: white;
      border-radius: 18px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      overflow-x: auto;
      padding: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 700px;
    }

    th, td {
      text-align: left;
      padding: 14px 12px;
      border-bottom: 1px solid #edf2f7;
      font-size: 0.92rem;
    }

    th {
      font-family: 'Poppins', sans-serif;
      color: var(--dark-color);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.8rem;
      background: #f8fafd;
    }

    .badge {
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      display: inline-block;
    }

    .badge-ativo { background: #e8f8f0; color: #0a7d2a; }
    .badge-pendente { background: #fef5e7; color: #d35400; }
    .badge-admin { background: #ebf5fb; color: #2980b9; }
    .badge-servidor { background: #f2f4f4; color: #566573; }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: opacity 0.2s;
    }

    .btn:hover { opacity: 0.88; }
    .btn-aprovar { background: #0a7d2a; color: white; }
    .btn-bloquear { background: #e67e22; color: white; }
    .btn-admin-toggle { background: #2980b9; color: white; }
    .btn-excluir { background: #e74c3c; color: white; }
    .voce-label { color: #7f8c8d; font-size: 0.82rem; font-style: italic; }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <div>
        <h1>Gestão de Usuários e Permissões</h1>
        <small>Aprove acessos pendentes ou defina novos administradores</small>
      </div>
      <a href="/" class="btn-voltar">&larr; Voltar ao Menu de Sistemas</a>
    </div>
  </header>

  <div class="container">
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>Login (Username)</th>
            <th>Status de Acesso</th>
            <th>Perfil / Cargo</th>
            <th>Ações do Administrador</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(u => { %>
            <tr>
              <td><strong><%= u.nome %></strong></td>
              <td><code><%= u.username %></code></td>
              <td>
                <% if (u.ativo) { %>
                  <span class="badge badge-ativo">Liberado</span>
                <% } else { %>
                  <span class="badge badge-pendente">Aguardando Aprovação</span>
                <% } %>
              </td>
              <td>
                <% if (u.cargo === 'admin') { %>
                  <span class="badge badge-admin">Administrador</span>
                <% } else { %>
                  <span class="badge badge-servidor">Servidor</span>
                <% } %>
              </td>
              <td>
                <% if (u.id === usuarioLogado.id) { %>
                  <span class="voce-label">Sua conta (Admin Atual)</span>
                <% } else { %>
                  <div class="actions">
                    <!-- Aprovar ou Bloquear Login -->
                    <form action="/admin/usuarios/<%= u.id %>/status" method="POST" style="margin:0;">
                      <input type="hidden" name="ativo" value="<%= !u.ativo %>">
                      <% if (!u.ativo) { %>
                        <button type="submit" class="btn btn-aprovar">Permitir Login</button>
                      <% } else { %>
                        <button type="submit" class="btn btn-bloquear">Bloquear</button>
                      <% } %>
                    </form>

                    <!-- Tornar Admin ou Remover Admin -->
                    <form action="/admin/usuarios/<%= u.id %>/cargo" method="POST" style="margin:0;">
                      <input type="hidden" name="cargo" value="<%= u.cargo === 'admin' ? 'servidor' : 'admin' %>">
                      <% if (u.cargo === 'admin') { %>
                        <button type="submit" class="btn btn-admin-toggle">Remover Admin</button>
                      <% } else { %>
                        <button type="submit" class="btn btn-admin-toggle">Tornar Admin</button>
                      <% } %>
                    </form>

                    <!-- Excluir Conta -->
                    <form action="/admin/usuarios/<%= u.id %>/excluir" method="POST" style="margin:0;" onsubmit="return confirm('Tem certeza que deseja excluir o usuário <%= u.username %>?');">
                      <button type="submit" class="btn btn-excluir">Excluir</button>
                    </form>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>